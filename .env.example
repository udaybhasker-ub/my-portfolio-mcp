NODE_ENV=development

# Google Drive Configuration (OAuth 2.0)
# Option 1: Place oauth-credentials.json in project root (local development)
# Option 2: Set OAUTH_CREDENTIALS_JSON as env var (base64-encoded JSON or plain JSON)
# OAUTH_CREDENTIALS_JSON=<credentials-json-or-base64>

# OAuth Token (Refresh Token)
# Option 1: Place tokens.json in project root (local development)
# Option 2: Set OAUTH_TOKEN_JSON as env var (base64-encoded JSON or plain JSON)
# OAUTH_TOKEN_JSON=<token-json-or-base64>

DRIVE_FOLDER_ID=

# Database Configuration
DATABASE_PATH=./portfolio_data.db
DATABASE_SYNC_INTERVAL_MINUTES=1
BACKUP_TIME_UTC=23:00
